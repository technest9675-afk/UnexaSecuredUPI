# ==============================================================================
# Unexa Application Environment Variables - Template Example
# DO NOT COMMIT REAL CREDENTIALS OR SERVICE KEYS TO VERSION CONTROL
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (Safe for client-side use with RLS enabled)
# Never use the service_role key in frontend client applications
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here
